# ==============================================================================
# Roboflow API Configuration
# ==============================================================================
# Get your API key from: https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Your public workspace name (e.g. "my-inventory-workspace")
ROBOFLOW_WORKSPACE=your_workspace_name_here

# Your project name/slug (e.g. "inventory-items")
ROBOFLOW_PROJECT=your_project_name_here

# Dataset version number to download (e.g. 3, by default 1)
ROBOFLOW_VERSION=1
