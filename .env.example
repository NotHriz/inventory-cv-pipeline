# ==============================================================================
# Roboflow API Configuration
# ==============================================================================
# Get your API key from: https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Your public workspace name (e.g. "my-inventory-workspace")
ROBOFLOW_WORKSPACE=your_workspace_name_here

# Your project name/slug (e.g. "inventory-items")
ROBOFLOW_PROJECT=your_project_name_here

# Dataset version number to download (e.g. 3, by default 1)
ROBOFLOW_VERSION=1

# ==============================================================================
# Model Upload (auto-push to cloud on training completion)
# ==============================================================================
# Method: local | email | sftp   (local = copy into cloud-synced folder)
UPLOAD_METHOD=local
# Cloud-synced folder (OneDrive/Google Drive/Dropbox) to copy the model into
UPLOAD_LOCAL_DIR=C:\Users\You\OneDrive\ModelBackup
# Seconds between checks for the finished model (default 30)
UPLOAD_POLL_INTERVAL=30
# Max seconds to keep watching, 0 = wait forever
UPLOAD_MAX_WAIT=0

# --- Email method (requires SMTP / Gmail App Password) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_APP_PASSWORD=your_16_char_app_password
# SMTP_TO=teammate@company.com

# --- SFTP method ---
# SFTP_HOST=host.example.com
# SFTP_USER=myuser
# SFTP_PORT=22
# SFTP_REMOTE_DIR=/path/on/server
